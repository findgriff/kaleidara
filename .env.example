# Server
NODE_ENV=development
PORT=8000
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=https://your-https-host.example

# Higgsfield credentials — keep these server-side and never commit .env
HF_API_KEY_ID=
HF_API_KEY_SECRET=
HF_API_BASE_URL=https://platform.higgsfield.ai
HF_JOB_STATUS_PATH=/v1/job-sets/{jobSetId}
HF_JOB_CANCEL_PATH=/v1/job-sets/{jobSetId}/cancel
# Optional JSON object, for example: {"soul":"/v1/text2image/soul"}
HF_MODEL_PATH_OVERRIDES=

# Guard rails
MAX_CREDITS_PER_GENERATION=200
CREDIT_USD_RATE=0
PROVIDER_TIMEOUT_MS=30000
JOB_RETENTION_MS=21600000
MAX_TRACKED_JOBS=500
DEBUG_PROVIDER_LOGGING=false
